		"@twinkleplop/core": "^0.3.2",
		"@twinkleplop/css": "^0.1.8",
		"@twinkleplop/dotenv": "^0.1.8",
		"@twinkleplop/html": "^0.1.8",
		"@twinkleplop/http": "^0.1.8",
		"@twinkleplop/ini": "^0.1.8",
		"@twinkleplop/javascript": "^0.1.8",
		"@twinkleplop/json": "^0.1.8",
		"@twinkleplop/jsonc": "^0.1.5",
		"@twinkleplop/markdown": "^0.2.2",
		"@twinkleplop/shellsession": "^0.1.8",
		"@twinkleplop/svelte": "^0.1.8",
		"@twinkleplop/toml": "^0.1.8",
		"@twinkleplop/tsx": "^0.1.8",
		"@twinkleplop/twoslash": "^0.3.2",
		"@twinkleplop/typescript": "^0.1.8",
		"@twinkleplop/yaml": "^0.1.8",
		"esm-env": "^1.2.2",
		"icons": "workspace:*",
		"json5": "^2.2.3"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.4.0",
		"@types/node": "catalog:",
		"flexsearch": "^0.8.212",
		"gzip": "workspace:*",
		"magic-string": "^1.4.5",
		"marked": "^18.2.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.20.0 || ^3.0.0-next.10 || ^3.0.0",
		"svelte": "^4.0.0 || ^5.0.0-next.1"
