{
	"name": "@sveltejs/site-kit",
	"version": "6.0.0-next.64",
	"description": "Styles and components for use in *.svelte.dev websites",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"check": "svelte-kit sync && svelte-check",
		"package": "svelte-kit sync",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"prepare": "svelte-kit sync"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/svelte.dev.git"
	},
	"author": "Rich Harris",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sveltejs/svelte.dev/issues"
	},
	"homepage": "https://github.com/sveltejs/svelte.dev/tree/main/packages/site-kit#readme",
	"dependencies": {
