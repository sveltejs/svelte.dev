{
	"name": "@sveltejs/repl",
	"version": "0.6.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "svelte-kit sync"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/svelte.dev.git"
	},
	"author": "The Svelte Team",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sveltejs/svelte.dev/issues"
	},
	"homepage": "https://github.com/sveltejs/svelte.dev/tree/main/packages/repl/#readme",
	"exports": {
		".": {
			"types": "./src/lib/public.d.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./bundler": {
			"types": "./src/lib/Bundler.svelte.ts",
			"default": "./src/lib/Bundler.svelte.ts"
		},
		"./editor": {
			"types": "./src/lib/Editor/Editor.svelte",
			"svelte": "./src/lib/Editor/Editor.svelte"
		},
		"./viewer": {
			"types": "./src/lib/Output/Viewer.svelte",
			"svelte": "./src/lib/Output/Viewer.svelte"
		},
		"./workspace": {
			"types": "./src/lib/Workspace.svelte.ts",
			"svelte": "./src/lib/Workspace.svelte.ts"
		},
		"./console": {
			"types": "./src/lib/Output/console/index.ts",
			"svelte": "./src/lib/Output/console/index.ts"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0-next.1"
	},
	"devDependencies": {
		"@lezer/common": "^1.5.5",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/estree": "^1.0.10",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"publint": "^0.3.25",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@jridgewell/sourcemap-codec": "^1.6.0",
		"@lezer/highlight": "^1.2.5",
		"@replit/codemirror-lang-svelte": "^6.0.0",
		"@replit/codemirror-vim": "^6.4.0",
		"@rich_harris/svelte-split-pane": "^3.0.0",
		"@rollup/browser": "^4.68.4",
		"@sveltejs/acorn-typescript": "^1.0.13",
		"@sveltejs/site-kit": "workspace:*",
		"@sveltejs/svelte-json-tree": "^2.2.1",
		"acorn": "^8.19.0",
		"codemirror": "^6.0.2",
		"esm-env": "^1.2.2",
		"esrap": "^2.4.2",
		"icons": "workspace:*",
		"locate-character": "^3.0.0",
		"magic-string": "^1.4.5",
		"marked": "^18.2.1",
		"resolve.exports": "^2.0.4",
		"svelte": "^5.58.0",
		"tailwindcss": "^4.3.5",
		"tarparser": "^0.0.5",
		"zimmerframe": "^1.1.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
